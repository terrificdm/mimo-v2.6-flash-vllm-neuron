# Secrets and environment
*.pem
*.key
.env
.env.*

# Model weights and tensor dumps (never commit; download / regenerate instead)
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.npy
/weights/
/models/

# Hugging Face cache
hf_cache/
hf-cache/
.cache/

# Generated by scripts/prepare_hf_reference.sh from the downloaded checkpoint (upstream remote code is not
# redistributed here; see NOTICE)
/reference/

# Neuron compile artifacts and profiles
*.neff
*.ntff
compiled/
neuron_cache/
compile_cache/
vllm-cache/
traced_model/
*.parquet

# Logs and run outputs
*.log
!tests/data/*.log
*.log.gz
*.log.tar.gz
*.log.zst
/logs/
# results/ holds the small curated results shipped with the tutorial (see results/README.md);
# results/task_eval_data/ is where scripts/api_tests/task_eval.py reads locally generated GSM8K / MMLU data
/results/task_eval_data/
/status/

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
build/
dist/

# OS / editor
.DS_Store
